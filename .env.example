# sql-auditor configuration
# Copy to .env at the root of the project and fill in SQL_SERVER. .env is
# gitignored - never commit it.
#
# Every key below is set to the value the tool would use anyway, so a verbatim
# copy of this file changes nothing except the server you point it at. Keys
# whose default is "leave it alone" are shown commented out; uncommenting one
# is a deliberate change, not a default.

# --- Connectivity (required) ---
SQL_SERVER=MYSERVER01
# SQL_SERVER=tcp:myhost.example.com,1433
# SQL_SERVER=MYSERVER01\SQLEXPRESS
SQL_DATABASE=master

# --- Precedence ---
# Values here override process environment variables of the same name.
# A command-line flag overrides both. This is intentional and differs from
# the usual twelve-factor ordering. See docs/dba-guide.md.
#
# Renamed: SQL_LOGIN is now SQL_USER. The tool errors on the old name.
#
# The set of keys is closed: any key not listed in this file stops the run.

# --- Authentication ---
# Leave SQL_USER/SQL_PASSWORD empty to use Windows integrated authentication.
SQL_USER=
SQL_PASSWORD=
# Set to true to force Windows auth even when SQL_USER is filled in.
SQL_INTEGRATED_SECURITY=false

# --- TLS ---
SQL_ENCRYPT=true
# true does NOT validate the server certificate. Set false if the instance
# presents a certificate this machine trusts.
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Timeouts (seconds) ---
SQL_CONNECT_TIMEOUT_SEC=15
# Bounds the collector's own round trips - permission probes, USE, session
# reset. It does NOT bound the queries: every query file declares its own
# @timeout, and a declared timeout wins. See docs/dba-guide.md.
SQL_QUERY_TIMEOUT_SEC=60

# --- Misc ---
# Shown in sys.dm_exec_sessions. Default: sql-auditor followed by the version,
# e.g. "sql-auditor 0.19.0", so a session seen on the server can be tied to the
# corpus that produced it. A value set here is used exactly as written and gets
# no version appended: it is usually chosen to be matched by a monitoring rule,
# and appending to it would break the match.
# SQL_APPLICATION_NAME=sql-auditor

# --- Paths ---
# QUERIES_DIR runs a corpus from disk INSTEAD of the one built into the binary.
# Leave it unset unless you mean that: setting it makes the run depend on a
# directory that must exist, and MANIFEST.txt then withdraws its claim that the
# queries are the published ones. Default: unset (use the embedded corpus).
# QUERIES_DIR=./my-queries
OUTPUT_DIR=output

# --- Database selection for @scope: database scripts ---
# DB_INCLUDE empty = all user databases. Both accept comma-separated * and ? wildcards.
DB_INCLUDE=
DB_EXCLUDE=

# --- Query Store extraction ---
# These only matter with --query-store-detail; the extraction is off otherwise.
# The window is either sliding (DAYS) or absolute (FROM/TO), and asking for
# both stops the run rather than picking one.
#
# QUERY_STORE_DAYS stays COMMENTED OUT even though 7 is its value, because the
# conflict is decided on the key being PRESENT, not on its value differing from
# the default: a QUERY_STORE_DAYS left in this file would make every run that
# passes --query-store-from or --query-store-to fail. Unset is what lets a
# bound through, and unset already means seven days.
# QUERY_STORE_DAYS=7
# Absolute bounds, YYYY-MM-DDTHH:MM or YYYY-MM-DD, read in the SERVER's local
# time. TO alone means seven days ending there. Default: unset.
# QUERY_STORE_FROM=2026-07-26T14:00
# QUERY_STORE_TO=2026-07-26T15:00
# Queries kept per database, across the four rankings once deduplicated.
# Queries with a forced plan are added on top of this.
QUERY_STORE_TOP=50
# Narrows which of the collected databases the extraction reads. Empty = all of
# them. It never widens the selection DB_INCLUDE/DB_EXCLUDE made.
QUERY_STORE_DB_INCLUDE=
