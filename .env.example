# sql-auditor configuration
# Copy to .env at the root of the project and fill in. .env is gitignored - never commit it.

# --- Connectivity (required) ---
SQL_SERVER=MYSERVER01
# SQL_SERVER=tcp:myhost.example.com,1433
SQL_DATABASE=master

# --- Precedence ---
# Values here override process environment variables of the same name.
# A command-line flag overrides both. This is intentional and differs from
# the usual twelve-factor ordering.
#
# Renamed: SQL_LOGIN is now SQL_USER. The tool errors on the old name.

# --- Authentication ---
# Leave SQL_USER/SQL_PASSWORD empty to use Windows integrated authentication.
SQL_USER=
SQL_PASSWORD=
# Set to true to force Windows auth even when SQL_USER is filled in.
SQL_INTEGRATED_SECURITY=false

# --- TLS ---
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# --- Timeouts (seconds) ---
SQL_CONNECT_TIMEOUT_SEC=15
SQL_QUERY_TIMEOUT_SEC=60

# --- Misc ---
SQL_APPLICATION_NAME=DiagCollector

# --- Paths (relative paths resolve from the project root) ---
QUERIES_DIR=queries
OUTPUT_DIR=output

# --- Database selection for @scope: database scripts ---
# DB_INCLUDE empty = all user databases. Both accept comma-separated * and ? wildcards.
DB_INCLUDE=
DB_EXCLUDE=
